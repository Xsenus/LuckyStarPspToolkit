{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lucky-star-psp:iso-patch-manifest:v1",
  "title": "Lucky Star PSP ISO patch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "replacements"
  ],
  "properties": {
    "schema": {
      "const": "lucky-star-psp.iso-patch-manifest.v1"
    },
    "expectedSourceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/replacement"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isoPath",
        "sourceFile"
      ],
      "properties": {
        "isoPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expectedOriginalSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "expectedOriginalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedReplacementSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "expectedReplacementSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
